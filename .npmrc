# Core settings for compatibility across environments
engine-strict=false
node-linker=isolated
shamefully-hoist=false

# Only hoist essential packages that require it
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=*@clerk/shared*
public-hoist-pattern[]=*sharp*

# Security settings with reasonable defaults
strict-peer-dependencies=false
auto-install-peers=true
enable-pre-post-scripts=false

# Improve performance
prefer-offline=true
cache-max-age=86400

# Lockfile management
prefer-frozen-lockfile=true
